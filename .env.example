# Banco relacional local
DATABASE_URL=sqlite:///./app.db

# Autenticação (preencha a chave somente no .env local)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM principal (Ecoa) e fallback de geração/análise (Groq)
ECOA_TIMEOUT_SECONDS=30
LLM_FALLBACK_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45
GROQ_TEMPERATURE=0
