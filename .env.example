# Banco relacional local
DATABASE_URL=sqlite:///./app.db

# Diagnóstico de desempenho de POST /query/ask no terminal do Uvicorn
RAG_PERF_LOG_ENABLED=false
RAG_LLM_HTTP_LOG_ENABLED=false
RAG_FAISS_INDEX_DIR=data/index/faiss/v1

# Fallback compartilhado entre Query Analyzer e geração RAG.
# Cada integrante escolhe localmente: none, openai ou groq.
ECOA_TIMEOUT_SECONDS=30
LLM_FALLBACK_PROVIDER=none
LLM_FALLBACK_OPENAI_MODEL=gpt-4.1-mini
LLM_FALLBACK_GROQ_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_TIMEOUT_SECONDS=45
GROQ_API_KEY=
OPENAI_API_KEY=

# Compatibilidade temporária com o fallback OpenAI anterior, exclusivo do Analyzer.
ANALYZER_OPENAI_FALLBACK_ENABLED=false
ANALYZER_OPENAI_MODEL=gpt-4.1-mini
ANALYZER_ECOA_TIMEOUT_SECONDS=60

# Autenticação (preencha a chave somente no .env local)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
