[Unit]
Description=Scheduler incremental diário do PNCP/RJ
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Área de Trabalho/desafio-contratacoes/rag-grande-desafio-grupo03-contratacoes-publicas
EnvironmentFile=%h/.config/pncp-incremental-scheduler.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m src.fetch_incremental_schedule --initial-start ${PNCP_INITIAL_START} --db-path ${PNCP_DB_PATH} --confirm-operational-database ${PNCP_DB_PATH} --log-path ${PNCP_LOG_PATH} --inter-shard-seconds 30 --execute
Restart=on-failure
RestartSec=1800
TimeoutStartSec=infinity
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths="%h/Área de Trabalho/desafio-contratacoes/rag-grande-desafio-grupo03-contratacoes-publicas/data/debug"
ReadWritePaths="%h/Área de Trabalho/desafio-contratacoes/rag-grande-desafio-grupo03-contratacoes-publicas/logs"

# O scheduler calcula ontem no fuso America/Sao_Paulo, replaneja a partir do
# watermark composto e retoma somente membros incompletos.
